# Copy to .env and fill in locally. Never commit the real key.
ROBOFLOW_API_KEY=

# Optional path overrides used by scripts and experiments.
HANDBALL_CV_VIDEO=data/raw/Han-Ber4.mp4
HANDBALL_CV_RUN_DIR=runs
SAM2_UPSTREAM_DIR=sam2-upstream
PARSEQ_UPSTREAM_DIR=parseq-upstream

# The sibling fine-tuning repo: a separate checkout, not a directory inside this
# one, so it defaults to a sibling of the repository root rather than a path
# under it. It holds the COCO export, the detector checkpoints, and the only venv
# with `rfdetr` -- the scripts needing that run under its interpreter, not ours.
RFDETR_FINETUNE_DIR=../rfdetr-handball-finetune
